<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.openwispr" path="/org/gnome/shell/extensions/openwispr/">
    <key name="hold-to-speak-enabled" type="b">
      <default>true</default>
      <summary>Enable hold to speak with Right Ctrl</summary>
    </key>
    <key name="hold-to-speak-trigger" type="s">
      <default>'ctrl-slash'</default>
      <summary>Hold to speak trigger key</summary>
    </key>
    <key name="auto-paste-enabled" type="b">
      <default>true</default>
      <summary>Automatically paste transcribed text into active app</summary>
    </key>
    <key name="toggle-recording" type="as">
      <default><![CDATA[['<Control><Alt>r']]]></default>
      <summary>Toggle recording</summary>
    </key>
  </schema>
</schemalist>
